PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional first-run Admin bootstrap. Leave blank to use setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Gemini AI. Without this key, the built-in safe tool router still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_RATE_LIMIT_PER_HOUR=20
