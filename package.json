{
  "name": "hcm-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon server.js\" \"npm --prefix frontend run dev\"",
    "start": "node server.js",
    "build": "npm --prefix frontend run build",
    "setup": "npm install && npm --prefix frontend install",
    "seed:demo": "node database/seed-demo.js",
    "reset:db": "node database/reset-db.js"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10"
  }
}
